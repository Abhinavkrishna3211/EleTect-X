# Copy to .env in this directory and fill in. .env is git-ignored.
#
#   cp .env.example .env
#
# docker compose refuses to start if any of these is empty, which is
# deliberate - an unset secret would otherwise expand to an empty string and
# the stack would come up insecure rather than not at all.

# Signs every ChirpStack login and API token. Generate a fresh one:
#
#   openssl rand -base64 32
#
# Changing it later invalidates all existing logins and API tokens.
CHIRPSTACK_API_SECRET=

# Password for the network server's own PostgreSQL database. This is not the
# EleTect X application database - that is Supabase, configured in
# ../ingest/.env. Generate one the same way.
POSTGRES_PASSWORD=

# LoRaWAN region. Drives the gateway-bridge MQTT topic templates and which
# Basics Station config is loaded. It must match enabled_regions in
# configuration/chirpstack/chirpstack.toml - see README.md, "Using a
# different region". in865 is the Indian band this deployment runs on.
CHIRPSTACK_REGION=in865

# Which ChirpStack application(s) the ingest bridge subscribes to, as UUIDs.
# Comma-separated for more than one. Find them in the ChirpStack UI under
# Applications - the ID is in the page URL and on the application's detail
# page. You will only have this after the first-run steps in README.md, so
# leave it until then.
CHIRPSTACK_APPLICATION_ID=
