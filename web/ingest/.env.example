# Local ChirpStack MQTT broker. The chirpstack-stack docker-compose exposes
# mosquitto on localhost:1883, so this is correct for local dev out of the box.
MQTT_URL=mqtt://localhost:1883

# Restrict to one ChirpStack application (recommended - avoids picking up
# uplinks from unrelated test applications on the same broker). Leave unset
# to subscribe to every application.
CHIRPSTACK_APPLICATION_ID=

# Supabase project. SUPABASE_SERVICE_ROLE_KEY bypasses RLS entirely, so this
# process must only ever run server-side - never ship this key to the
# frontend, never commit a filled-in .env (see .gitignore).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
