	(text "HOST  (UNO Q)"
		(exclude_from_sim no)
		(at 56 51 0.0000)
		(effects
			(font
				(size 2.8 2.8)
				(bold yes)
			)
		)
		(uuid "6b492a9f-1c5d-4b8a-83ba-90c227e090aa")
	)
	(text "D0 / D1 = USART1 (3.3 V pins)\nD4 select: LOW = DFPlayer PRO, HIGH = LoRa-E5\nD11 gate HIGH = amp powered"
		(exclude_from_sim no)
		(at 56 210 0.0000)
		(effects
			(font
				(size 1.8 1.8)
			)
		)
		(uuid "9da446f6-931d-461d-a6c6-4f3e678626fb")
	)
	(text "SHARED UART  (74HC4053 + DFPlayer PRO + LoRa-E5)"
		(exclude_from_sim no)
		(at 186.5 51 0.0000)
		(effects
			(font
				(size 2.8 2.8)
				(bold yes)
			)
		)
		(uuid "d7b98220-7798-4f1b-9397-74cdc25e59a3")
	)
	(text "74HC4053 runs at 3.3 V; the horn always wins the shared port (ADR 0029)\nDFPlayer PRO 115200 baud, LoRa-E5 9600 baud: each switch re-opens Serial1\n10k pull-ups hold the deselected RX line idle high\nR305 pulls D4 low at reset: DFPlayer PRO selected by default\n1k series R306 / R307 limit clamp current if a module TX swings above 3.3 V\nUnused 4053 pins (C, Inh, VEE, Z, Z0, Z1) are tied to GND"
		(exclude_from_sim no)
		(at 186.5 210 0.0000)
		(effects
			(font
				(size 1.8 1.8)
			)
		)
		(uuid "e653056a-a601-496e-862d-931190ee8511")
	)
	(text "HORN  (XH-M543 amp + Ahuja SUH-15)"
		(exclude_from_sim no)
		(at 328 51 0.0000)
		(effects
			(font
				(size 2.8 2.8)
				(bold yes)
			)
		)
		(uuid "915e178d-1b74-4209-b049-672d7a272fff")
	)
	(text "Q304 switches the amp ground: gate HIGH = amp on\nF302 3A fuse, D301 TVS and C306 bulk cap protect the amp supply\nTurn VOL_L fully down before first power-on\nDACL feeds INL, not the DFPlayer L+ / L- pins\nAmp joins its input and power grounds on the board:\ncheck it goes quiet with D11 LOW (DFPlayer GND is a 2nd return)"
		(exclude_from_sim no)
		(at 328 210 0.0000)
		(effects
			(font
				(size 1.8 1.8)
			)
		)
		(uuid "95636951-a70f-4bf3-b99a-81c81cc434fa")
	)
	(text "EleTect X  -  DFPLAYER PRO + HORN AMP + SHARED UART"
		(exclude_from_sim no)
		(at 200 20 0.0000)
		(effects
			(font
				(size 4.5 4.5)
				(bold yes)
			)
		)
		(uuid "c3704da5-7809-4c15-9035-d7a3d8b7ec9e")
	)
	(text "UNO Q USART1 > 74HC4053 > DFPlayer PRO / LoRa-E5;  DFPlayer DACL > XH-M543 amp > Ahuja SUH-15 horn"
		(exclude_from_sim no)
		(at 200 31 0.0000)
		(effects
			(font
				(size 2.2 2.2)
			)
		)
		(uuid "9d0c78b1-e4f8-417d-9fe2-d19a13287bff")
	)
	(text "Horn amp runs from the raw 12.8 V battery bus; DFPlayer PRO and LoRa-E5 run from the UNO Q 5 V pin"
		(exclude_from_sim no)
		(at 200 38 0.0000)
		(effects
			(font
				(size 1.8 1.8)
			)
		)
		(uuid "9459e0e1-c076-4dd0-903e-1b8c812a7110")
	)
