# EleTect X - credentials for the acoustic-model build pipeline.
#
# Copy this file to secrets/acoustic_pipeline.env and fill in real values there:
#
#   cp secrets/acoustic_pipeline.env.example secrets/acoustic_pipeline.env
#   chmod 600 secrets/acoustic_pipeline.env      # POSIX hosts; see note below
#   source secrets/acoustic_pipeline.env
#
# secrets/ is gitignored as a whole directory (see the "--- Secrets ---" block in
# .gitignore). The single exception is *.env.example, tracked so a fresh clone
# can discover which variables the pipeline needs. Never put a real value in a
# file whose name ends .example.
#
# On a POSIX host chmod 600 these files. On Windows the mode bits Git Bash prints
# are not what NTFS enforces, so rely on the directory's ACL instead.
#
# The project id below is not a secret - ADR 0032 names it in the tracked tree
# already. Only the key fields are sensitive.

EI_API_KEY=                 # Edge Impulse project API key for the acoustic project
EI_PROJECT_ID=1110036       # the production acoustic project (ADR 0032), named "ETX-A" in
                            # Studio since 2026-10-03. It was "ETX-Test" before that; the
                            # dormant project 1109511 took the "ETX-A" name, so match on the
                            # id, not the name. Do not overwrite 1110036 - it ships.

# Freesound. The pipeline sends the key as a ?token= query parameter because that
# is Freesound's documented auth scheme; edge_impulse_upload_acoustic.py masks it
# out of any error text before printing (_redact), so a failed request does not
# put the key in a log.
FREESOUND_CLIENT_ID=
FREESOUND_API_KEY=

# Optional second Freesound account. Freesound rate-limits per key, and a full
# corpus rebuild will exhaust one; the fetcher falls back to these when set.
FREESOUND_CLIENT_ID_ALT=
FREESOUND_API_KEY_ALT=

# Optional. xeno-canto API v3 requires an account key (v2 is retired). Unset
# means the xeno-canto sources contribute zero clips, which the run reports
# rather than failing on.
XENOCANTO_API_KEY=
