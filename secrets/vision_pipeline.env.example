# EleTect X - ETX-V credentials for the vision-model build pipeline.
#
# Copy this file to secrets/vision_pipeline.env and fill in real values there:
#
#   cp secrets/vision_pipeline.env.example secrets/vision_pipeline.env
#   chmod 600 secrets/vision_pipeline.env        # POSIX hosts; see note below
#   source secrets/vision_pipeline.env
#
# secrets/ is gitignored as a whole directory (see the "--- Secrets ---" block in
# .gitignore). The single exception is *.env.example, which is tracked precisely
# so a fresh clone can discover which variables the pipeline needs - the scripts
# name this file in their error messages, and for a long time it did not exist
# outside one working copy. Never remove the secrets/ entry, and never put a real
# value in a file whose name ends .example.
#
# On a POSIX host chmod 600 these files. On Windows the mode bits Git Bash prints
# are not what NTFS enforces, so rely on the directory's ACL instead.
#
# Project and workspace identifiers below are not secrets - they appear
# throughout docs/ and ml/ already. Only the key fields are sensitive.

EI_API_KEY=                 # Edge Impulse project API key, ETX-V project (1097972)
EI_PROJECT_ID=1097972       # ETX-V, org "Edge Impulse Experts", Enterprise. 1094260 is a
                            # separate legacy free-tier project - do not confuse the two.
EI_ORG_API_KEY=             # org-level key, "Edge Impulse Experts" org - NOT needed for the
                            # EON Tuner. The 23 Aug finding that project-scoped keys 404 on
                            # tuner/* was a wrong-endpoint-path artifact (guessed /tuner/*
                            # paths that do not exist); the real paths are
                            # /api/{project}/optimize/*, confirmed reachable with the plain
                            # project key (27 Aug). Leave empty unless something needs it.
EI_HMAC_KEY=                # optional - only needed if signing ingested data
RF_API_KEY=                 # Roboflow private key, workspace "eletect"
RF_WORKSPACE_ID=eletect
RF_API_KEY_2=               # optional - second Roboflow account, used when a dataset lives
                            # outside the "eletect" workspace
RF_WORKSPACE_ID_2=
HF_TOKEN=                   # optional - Hugging Face read token, for gated dataset mirrors
