# --- Local editor/tool config (keep out of the shared repo) ---
# Machine-local tooling notes are excluded via .git/info/exclude, which is not
# committed — this file stays free of local tool names.
*.local.md

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / frontend ---
node_modules/
dist/
# tsc -b incremental state; regenerated by every build.
*.tsbuildinfo
build/
.vite/
.next/
.env
.env.*
!.env.example

# --- Supabase CLI (keep config.toml; ignore generated local state) ---
# Broad match: the CLI writes .temp/.branches wherever it is run, not just web/backend.
**/supabase/.temp/
**/supabase/.branches/

# --- Firmware build ---
device/mcu/**/build/
*.elf
*.bin
*.hex
.pio/

# --- AI / data (store pointers, not large binaries) ---
ml/datasets/**/*.zip
ml/datasets/**/*.npy
ml/datasets/**/raw/
ml/datasets/vision/pseudo_ir/
device/mpu/models/**/*.tflite
device/mpu/models/**/*.eim
*.onnx
*.pt
*.pth
ml/vision/_*.log
ml/vision/_*.json
audit_boar_sample.log

# --- Design export cache (keep the .dc.html spec + assets, not the paste cache) ---
docs/design-reference/uploads/

# --- Bench-session capture artifacts (reproducible via scripts/, not source) ---
scripts/bench-logs/
device/mpu/bench/camera_check/output/

# Field and bench capture pulls under camera_check/. These are evidence, not
# source: roughly 17 GB across ~49,000 frames, written by the handful of tools
# that sit in the same directory. The tools are tracked; what they produce is
# not. Each pattern names a directory the capture scripts create, rather than
# ignoring camera_check/ wholesale - a blanket rule there would silently hide
# the next tool someone adds beside them, which is the mistake that left this
# directory untracked and unnoticed in the first place.
device/mpu/bench/camera_check/board_pull_*/
device/mpu/bench/camera_check/field_run_*/
device/mpu/bench/camera_check/field_clips_*/
device/mpu/bench/camera_check/fox_encounter_*/
device/mpu/bench/camera_check/encounter_clips_*/
device/mpu/bench/camera_check/*.lnk

# Same rule for the 29 Sept real-clip model comparison: the extracted frames and
# the saved detection crops are evidence pulled off the board, while clips.jsonl,
# live.jsonl and the scripts that wrote them are the record and stay tracked. A
# clone cannot regenerate the jsonl - the frames it scored are not here - which is
# why the derived files are tracked and the inputs are not.
device/mpu/bench/realclip_eval_20260929/frames/
device/mpu/bench/realclip_eval_20260929/live_hits/

# --- KiCad (hardware/pcb/) ---
# Track the schematic sources, the project files and the ERC reports; ignore
# everything a tool regenerates or that belongs to one person's install.
# .kicad_prl is per-user window/panel state and conflicts on every open.
# _root_uuid*.txt is scratch written by the generator script. The zoom PNGs are
# review screenshots of regions of a schematic that is itself tracked - reading
# the .kicad_sch gives the same information and does not go stale when the
# schematic changes. The .svg is a second plot of the same sheet as the .pdf.
hardware/pcb/*.kicad_prl
hardware/pcb/_root_uuid*.txt
hardware/pcb/led_ir_full.png
hardware/pcb/led_ir_zoom*.png
hardware/pcb/geophone-frontend.svg
hardware/pcb/*-backups/
hardware/pcb/*.kicad_sch-bak

# --- MPU runtime state (bandit experience DB + deterrent-event captures) ---
device/mpu/data/

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
.~lock.*#

# --- Secrets ---
# "secrets/*" and not "secrets/": git never descends into an ignored
# *directory*, so a negation underneath a plain directory entry can never
# match and the templates below would stay invisible. Everything in here is
# still ignored except the *.env.example files, which carry variable names
# and commentary and no values - they are tracked because the pipeline
# scripts name them in their error messages ("source secrets/
# vision_pipeline.env first") while a clone had no way to find out what to
# put in one. Anything with a real value in it must not end .example.
secrets/*
!secrets/*.env.example
*.key
*.pem
device/mcu/src/secrets.h

# --- Local session-output scratch (not project deliverables) ---
Session outputs/

# --- Internal working/session docs (local only, not product deliverables) ---
/HANDOVER.md
/CONTEXT.md
/EleTect-X.code-workspace
/docs/VISION_MODEL_BUILD_PROMPT.md
/docs/qa/boar-gap-session-notes.md
/docs/BUILD_BLUEPRINT_AUG20.md
/docs/BUILD_BLUEPRINT_AUG8.md
/docs/DEVICE_DEVELOPMENT_WORKFLOW.md
/docs/ELETECT_X_PITCH.md
/docs/ENGINEERING_CONVENTIONS.md
/docs/KNOWN_GAPS.md
/docs/PROJECT_BLUEPRINT.md
/docs/README.md
/docs/STRUCTURE.md
/docs/WEBAPP_COMPLETION_PLAN.md
/docs/eletect-x-applab-notes.md

# Acoustic eval harness: regenerable feature caches and run logs.
# split.json is deliberately NOT ignored - it is the frozen split, and a result
# quoted against a split that is not in the repo is not reproducible.
ml/acoustic/harness/*.npz
# calibration mel caches, tens of MB, regenerated by export_panns.py on demand
ml/acoustic/harness/*.npy
ml/acoustic/harness/*.log
ml/acoustic/harness/index*.json
ml/datasets/acoustic/raw/_audioset_clips/
ml/datasets/acoustic/raw/_vggsound_clips/

# Field captures recorded on this project's own hardware. 141 MB of raw wav
# across three capture rigs, and the `ml/datasets/**/raw/` rule above does not
# reach them because they live under manual_sources/. These are the scarcest
# asset in the acoustic track - five real recording sessions, not reproducible
# from any public corpus - so they need a backup somewhere that is not this
# working tree, but they are audio, not source, and do not belong in git.
ml/datasets/acoustic/manual_sources/

# Acoustic harness derived caches. Both are keyed by filename, not by content, so a
# checked-in copy would serve stale values to a `--resume` run after audio is
# regenerated under the same names - the failure the 2026-09-23 ADR 0025 amendment
# records. They are cheap to rebuild and must never be shared.
ml/acoustic/harness/payload_hashes.json
ml/acoustic/harness/audit_*.json

# Per-unit MCU overrides (see device/mcu/src/config.h)
device/mcu/src/config_local.h

# QA screenshot runs. Every one of these is regenerated by the scripts in
# web/frontend/scripts/ against the running app, so the repository was
# carrying 63 MB - half a clone - of output that nothing references and that
# is stale the moment the UI changes. phase4a/ is the exception and stays
# tracked: its NOTES.md names those four files.
docs/qa/**/*.png
docs/qa/**/*.jpg
docs/qa/**/*.jpeg
docs/qa/**/*.gif
docs/qa/**/*.webp
!docs/qa/phase4a/*.png
