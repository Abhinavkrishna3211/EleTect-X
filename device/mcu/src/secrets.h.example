// LoRaWAN OTAA credentials - template.
//
// Copy this file to secrets.h (gitignored, never committed) and fill in the
// real values issued when the device is registered with ChirpStack. secrets.h
// itself must never appear in a commit, a log line, or a bug report -
// src/lora/mac.cpp never prints these strings back over the console.
//
// DevEUI/AppEUI(JoinEUI)/AppKey are per-device OTAA identifiers, not a shared
// project secret - each node gets its own when it is provisioned.

#ifndef SECRETS_H
#define SECRETS_H

#define LORA_DEV_EUI "0000000000000000"
#define LORA_APP_EUI "0000000000000000"
#define LORA_APP_KEY "00000000000000000000000000000000"

#endif  // SECRETS_H
